# ==============================================================================
# Evidence-Grounded Misinformation Triage System (ML-09)
# Environment Configuration Template
# ==============================================================================

# Application & Runtime
APP_ENV=production
APP_DEBUG=false
LOG_LEVEL=INFO
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=0.0.0.0

# Storage & Model Artifact Paths
DATA_PROCESSED_DIR=data/processed
MODELS_DIR=models
AUDIT_LOG_PATH=data/audit_log.jsonl

# Operational Triage & Policy Defaults
DEFAULT_DAILY_CAPACITY=20
ESCALATE_P_THRESH=0.80
ESCALATE_REACH_THRESH=0.80
WAITLIST_P_THRESH=0.50
AGING_BOOST_RATE=0.10
MAX_AGING_BOOST=1.50

# Topic Harm Weight Multipliers
HARM_WEIGHT_CRITICAL=1.5
HARM_WEIGHT_SENSITIVE=1.2
HARM_WEIGHT_DEFAULT=1.0

# External Webhooks & Alerting (Optional)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK
PAGERDUTY_INTEGRATION_KEY=your-pagerduty-key-here
